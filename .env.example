# All optional. Kindred runs fully offline without any of these.
PORT=4000

# Session signing secret. Set this in any shared/demo deploy.
KINDRED_SECRET=change-me-in-prod

# Passcode judges type on the login screen ("Judge access").
JUDGE_PASSCODE=kindred

# If set, reframes, read-backs and tea invites are generated by a model, reached
# through OpenRouter. If unset, Kindred falls back to its local rule-based
# engine and the demo still works end to end.
#
# Get a key at https://openrouter.ai/keys — it starts with `sk-or-v1-`.
# OPENROUTER_MODEL takes any slug OpenRouter fronts, so swapping provider is a
# one-line edit here:
#   openai/gpt-4o-mini          cheap, fast, the default
#   anthropic/claude-3.5-haiku  better at the short, concrete voice Kindred uses
#   google/gemini-flash-1.5     cheapest of the three
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. OpenRouter shows these on its app leaderboard; nothing breaks without them.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Kindred

# Only needed to bypass OpenRouter and talk to a provider directly. Leave unset.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# If set, team nudges are really posted to Slack. If unset they are logged
# to the in-app #kindred channel view instead.
SLACK_WEBHOOK_URL=

# If set, `npm run harvest` searches an allowlist of quality publishers
# (Harvard Health, Stanford, APA, Nature, WHO, Greater Good, Psychology Today…)
# for the source behind each recommended action, and stores the citation.
# Without it Kindred runs on the curated evidence set in server/practices.js.
EXA_API_KEY=
