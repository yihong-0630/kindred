# All optional. Kindred runs fully offline without any of these.
PORT=4000

# Session signing secret. Set this in any shared/demo deploy.
KINDRED_SECRET=8888

# Passcode judges type on the login screen ("Judge access").
JUDGE_PASSCODE=9999

# If set, reframes are generated by the model. If unset, Kindred falls back to
# its local rule-based reframe engine and the demo still works end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# If set, team nudges are really posted to Slack. If unset they are logged
# to the in-app #kindred channel view instead.
SLACK_WEBHOOK_URL=
